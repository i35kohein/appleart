# Apple Art React SPA — Apache rewrite
# Serves index.html for React Router paths while leaving real files and /api/*.php alone.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never rewrite real files or directories (assets, uploads, api/*.php, manifest…)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite API calls (let PHP handle them)
  RewriteRule ^api/ - [L]

  # Everything else -> SPA
  RewriteRule . index.html [L]
</IfModule>

# Cache hashed assets aggressively (they change name per build)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
